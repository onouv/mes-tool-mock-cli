@startuml
!pragma teoz true
actor User
participant "<<actor>>\nTool" as Tool
participant "<<actor>>\nInport" as Inport
participant "<<actor>>\nProcess" as Process
participant "<<actor>>\nOutport" as Outport

note over Tool: STOPPED
note over Inport: [part5, part4];\ndownstream_blocked: false
note over Process:  [part3]\nis_busy: false\ndownstream_blocked: false
note over Outport: [part2, part1]\nis_full: false

User -> Tool: StartCmd
Tool -> Inport: StartNextCycleCmd()
Inport -> Process: PushDownStream(part4)
Process --> Process: part3 = self.swap(part4)
Process -> Outport: PushDownStream(part3)
Outport --> Outport
note over Outport: [part3, part2, part1]\nis_full: false
Process <- Outport: MaterialFlowResult(Ok(NOT_BLOCKED))
Process --> Process: self.unblock()
note over Process:  [part4]\nis_busy: false\ndownstream_blocked: false
Inport <- Process: MaterialFlowResult(Ok(NOT_BLOCKED))
Inport --> Inport: self.unblock()
note over Inport: [part5];\ndownstream_blocked: false
Tool <- Inport: MaterialFlowResult(Ok())

Tool -> Process: StartOperationCmd()
Process --> Process: part4 = simulate_outcome()
{start} Process -> Future ** : spawn
Future --> Future: sleep(PROCESS_CYCLE_TIME)
Process --> Process: is_busy = true
Tool <- Process: ProcessResult(OK())
note over Tool: RUNNING
User <- Tool: ToolResult(Ok())

{end} Tool <- Future: ProcessFinished
{start} <-> {end}: PROCESS_CYCLE_TIME
Future --> Future !!
Tool -> Inport: StartNextCycleCmd()
Inport -> Process: PushDownStream(part5)
Process --> Process: part4 = self.swap(part5)
Process -> Outport: PushDownStream(part4)
Outport --> Outport
note over Outport: [part4, part3, part2, part1]; is_full = true
Process <- Outport: MaterialFlowResult(Ok(BLOCKED))
Process --> Process: self.block()
note over Process: [part5]\ndownstream_blocked: true
Inport <- Process: MaterialFlowResult(Ok(BLOCKED))
Inport --> Inport: self.block()
note over Inport: [-],\ndownstream_blocked: true
Tool <- Inport MaterialFlowResult(Ok(EMPTY))
@enduml