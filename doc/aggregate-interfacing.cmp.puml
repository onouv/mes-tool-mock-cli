@startuml

component Tool <<root-actor>>
component Inport <<actor>>
component Process <<actor>>
component Outport <<actor>>

interface "ProcessFinishedSgn" as TF
interface "StartNextCycleCmd" as IPpd 
interface "PushDownstreamCmd" as Ppd
interface "PushDownstreamCmd" as OPpd
interface "LoadCmd(Part)" as IPl
interface "StartOperationCmd" as Ps
interface "AbortOperationCmd" as Pa
interface "UnloadCmd() -> Part" as OPul

Tool --() TF

Inport --() IPpd
Inport -up-() IPl
 
Process -left-() Ppd
Process-up-() Ps
Process-up-() Pa

Outport -left-() OPpd
Outport -up-() OPul

Process -right-> OPpd
Inport -right-> Ppd

Tool --> IPl 
Process .up.> TF
Tool -down-> IPpd
Tool -down-> Ps
Tool -down-> Pa
Tool -down-> OPul

@enduml