@startuml

class Tool <<root-actor>>
component Inport <<actor>>
component Process <<actor>>
component Outport <<actor>>

Tool "MaterialFlowResult" -left-> "StartNextCycleCmd" Inport
Tool "MaterialFlowResult" -left-> "LoadCmd(Part)" Inport

Inport "MaterialFlowResult" -down-> "PushDownstreamCmd" Process
Process "MaterialFlowResult" -right-> "PushDownstreamCmd" Outport

Tool "ProcessResult" --> "StartOperationCmd" Process

Tool "ProcessResult" --> "AbortOperationCmd" Process

Tool "MaterialFlowResult" --> "UnloadCmd()" Outport 

@enduml